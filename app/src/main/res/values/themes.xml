<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Every theme takes its colours from values/ (light) and values-night/ (dark). -->
    <style name="Theme.CarLCD" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">?attr/cScreenTop</item>
        <item name="android:navigationBarColor">?attr/cScreenBottom</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowNoTitle">true</item>
        <!-- no blank "starting" window: it was drawn in light colours and showed as a white flash -->
        <item name="android:windowDisablePreview">true</item>
        <item name="cScreenTop">@color/screen_top</item><item name="cScreenBottom">@color/screen_bottom</item>
        <item name="cRail">@color/rail</item><item name="cCard">@color/card</item><item name="cTile">@color/tile</item>
        <item name="cHair">@color/hair</item><item name="cFg">@color/fg</item><item name="cSoft">@color/soft</item>
        <item name="cMuted">@color/muted</item><item name="cAccent">@color/accent</item><item name="cOnAccent">#FFFFFFFF</item>
        <item name="cGlow">@color/glow</item><item name="cDial">@color/compass_dial</item>
        <item name="cTick">@color/compass_tick</item><item name="cTick2">@color/compass_tick_minor</item>
    </style>

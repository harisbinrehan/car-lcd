<?xml version="1.0" encoding="utf-8"?>
<!-- Designed for the unit's 1280x648 app area (mdpi, 1dp = 1px), matching the web preview:
     rail | left column (time, weather) | car stage | right column (speed, heading), dock underneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:background="@drawable/screen_bg">

    <!-- RAIL -->
    <LinearLayout
        android:layout_width="90dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="2dp"
        android:background="@drawable/rail_bg">

        <LinearLayout android:id="@+id/item_home" style="@style/RailItem" android:background="@drawable/rail_home_bg">
            <ImageView style="@style/RailIcon" android:src="@drawable/ic_home" />
            <TextView style="@style/RailLabel" android:text="Home" android:textColor="?attr/cOnAccent" />
        </LinearLayout>

        <LinearLayout android:id="@+id/item_music" style="@style/RailItem">
            <ImageView style="@style/RailIcon" android:src="@drawable/ic_music" />
            <TextView style="@style/RailLabel" android:text="Music" />
        </LinearLayout>

        <LinearLayout android:id="@+id/item_apps" style="@style/RailItem">
            <ImageView style="@style/RailIcon" android:src="@drawable/ic_apps" />
            <TextView style="@style/RailLabel" android:text="Apps" />
        </LinearLayout>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <LinearLayout android:id="@+id/item_theme" style="@style/RailItem">
            <ImageView style="@style/RailIcon" android:src="@drawable/ic_theme" />
            <TextView android:id="@+id/txt_theme" style="@style/RailLabel" android:text="Auto" />
        </LinearLayout>

        <LinearLayout android:id="@+id/item_settings" style="@style/RailItem">
            <ImageView style="@style/RailIcon" android:src="@drawable/ic_settings" />
            <TextView style="@style/RailLabel" android:text="Settings" />
        </LinearLayout>
    </LinearLayout>

    <!-- MAIN -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:baselineAligned="false">

            <!-- LEFT COLUMN -->
            <LinearLayout android:layout_width="280dp" android:layout_height="match_parent" android:orientation="vertical">

                <LinearLayout style="@style/Card" android:layout_weight="1" android:gravity="center_vertical">
                    <TextView android:id="@+id/txt_greeting" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Good evening" android:textColor="?attr/cSoft" android:textSize="17sp"
                        android:fontFamily="sans-serif-medium" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:id="@+id/txt_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="9:41" android:textColor="?attr/cFg" android:textSize="70sp"
                            android:fontFamily="sans-serif-light" android:includeFontPadding="false" />
                        <TextView android:id="@+id/txt_ampm" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="PM" android:textColor="?attr/cMuted" android:textSize="19sp"
                            android:fontFamily="sans-serif-medium" android:layout_marginStart="7dp" />
                    </LinearLayout>
                    <TextView android:id="@+id/txt_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Wednesday, November 25" android:textColor="?attr/cMuted" android:textSize="16sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout style="@style/Card" android:layout_weight="1" android:layout_marginTop="12dp">
                    <TextView style="@style/CardLabel" android:text="Weather" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:id="@+id/img_weather" android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/ic_sun" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="vertical" android:layout_marginStart="16dp">
                            <TextView android:id="@+id/txt_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="--°" android:textColor="?attr/cFg" android:textSize="54sp"
                                android:fontFamily="sans-serif-light" android:includeFontPadding="false" />
                            <TextView android:id="@+id/txt_cond" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="" android:textColor="?attr/cSoft" android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="High" android:textColor="?attr/cMuted" android:textSize="15sp" />
                        <TextView android:id="@+id/txt_high" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--°" android:textColor="?attr/cFg" android:textSize="15sp"
                            android:fontFamily="sans-serif-medium" android:layout_marginStart="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Low" android:textColor="?attr/cMuted" android:textSize="15sp" android:layout_marginStart="19dp" />
                        <TextView android:id="@+id/txt_low" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--°" android:textColor="?attr/cFg" android:textSize="15sp"
                            android:fontFamily="sans-serif-medium" android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- STAGE: the car (tap its lights, wheels, mirror, fog lamps) with Now Playing underneath -->
            <FrameLayout
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="12dp" android:layout_marginEnd="12dp">
                <View
                    android:layout_width="460dp" android:layout_height="330dp"
                    android:layout_gravity="center" android:layout_marginBottom="64dp"
                    android:background="@drawable/halo" />
                <com.harislcd.launcher.CarView android:id="@+id/car_view"
                    android:layout_width="520dp" android:layout_height="292dp"
                    android:layout_gravity="center" android:layout_marginBottom="64dp"
                    android:focusable="true" android:contentDescription="Toyota Vitz" />
                <LinearLayout android:id="@+id/np_root" android:layout_width="match_parent" android:layout_height="96dp" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical" android:minHeight="88dp" android:background="@drawable/card_focus_bg" android:clickable="true" android:focusable="false" android:layout_gravity="bottom" android:paddingStart="14dp" android:paddingEnd="8dp">
<FrameLayout android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/tile_bg">
<ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_music" android:layout_gravity="center"/>
</FrameLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:baselineAligned="false" android:layout_weight="1" android:layout_marginStart="14dp" android:layout_marginEnd="6dp">
<TextView android:id="@+id/np_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nothing playing" android:textSize="22sp" android:textColor="?attr/cFg" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:singleLine="true" android:ellipsize="marquee" android:marqueeRepeatLimit="marquee_forever"/>
<TextView android:id="@+id/np_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap play to start" android:textSize="16sp" android:textColor="?attr/cMuted" android:maxLines="1" android:includeFontPadding="false" android:layout_marginTop="4dp" android:ellipsize="end"/>
</LinearLayout>
<ImageView android:id="@+id/np_prev" android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/ic_prev" android:padding="19dp" android:background="@drawable/focus_bg" android:nextFocusRight="@+id/np_play" android:clickable="true" android:focusable="true"/>
<ImageView android:id="@+id/np_play" android:layout_width="84dp" android:layout_height="84dp" android:src="@drawable/ic_play" android:padding="23dp" android:background="@drawable/np_play_bg" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:nextFocusLeft="@+id/np_prev" android:nextFocusRight="@+id/np_next" android:clickable="true" android:focusable="true"/>
<ImageView android:id="@+id/np_next" android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/ic_next" android:padding="19dp" android:background="@drawable/focus_bg" android:nextFocusLeft="@+id/np_play" android:clickable="true" android:focusable="true"/>
</LinearLayout>
            </FrameLayout>

            <!-- RIGHT COLUMN -->
            <LinearLayout android:layout_width="280dp" android:layout_height="match_parent" android:orientation="vertical">

                <LinearLayout style="@style/Card" android:layout_weight="1">
                    <TextView style="@style/CardLabel" android:text="Speed" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                        android:orientation="horizontal" android:gravity="center">
                        <TextView android:id="@+id/txt_speed" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="?attr/cFg" android:textSize="90sp"
                            android:fontFamily="sans-serif-light" android:includeFontPadding="false" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="km/h" android:textColor="?attr/cMuted" android:textSize="18sp"
                            android:fontFamily="sans-serif-medium" android:layout_marginStart="9dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/Card" android:layout_weight="1.15" android:layout_marginTop="12dp">
                    <TextView style="@style/CardLabel" android:text="Heading" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <com.harislcd.launcher.CompassView android:id="@+id/compass_view"
                            android:layout_width="130dp" android:layout_height="130dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/txt_heading_card" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="--" android:textColor="?attr/cFg" android:textSize="42sp"
                                android:fontFamily="sans-serif-light" android:includeFontPadding="false" />
                            <TextView android:id="@+id/txt_heading_deg" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="" android:textColor="?attr/cMuted" android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- DOCK -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="115dp"
            android:layout_marginTop="12dp" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:id="@+id/tile_radio" style="@style/Tile">
                <ImageView android:layout_width="37dp" android:layout_height="37dp" android:src="@drawable/ic_radio" />
                <TextView style="@style/TileText" android:text="Radio" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tile_bt" style="@style/Tile" android:layout_marginStart="12dp">
                <ImageView android:layout_width="37dp" android:layout_height="37dp" android:src="@drawable/ic_bluetooth" />
                <TextView style="@style/TileText" android:text="Bluetooth" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tile_auto" style="@style/Tile" android:layout_marginStart="12dp">
                <ImageView android:layout_width="37dp" android:layout_height="37dp" android:src="@drawable/ic_aa" />
                <TextView style="@style/TileText" android:text="Android Auto" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tile_eq" style="@style/Tile" android:layout_marginStart="12dp">
                <ImageView android:layout_width="37dp" android:layout_height="37dp" android:src="@drawable/ic_eq" />
                <TextView style="@style/TileText" android:text="Equalizer" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tile_youtube" style="@style/Tile" android:layout_marginStart="12dp">
                <ImageView android:layout_width="39dp" android:layout_height="28dp" android:src="@drawable/ic_youtube" />
                <TextView style="@style/TileText" android:text="YouTube" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
